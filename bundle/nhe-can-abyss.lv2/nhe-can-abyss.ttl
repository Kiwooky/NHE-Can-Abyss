@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<https://github.com/Kiwooky/NHE-Can-Abyss>
    a lv2:Plugin , lv2:DelayPlugin ;
    doap:name "Can-Abyss Delay" ;
    doap:license <http://opensource.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "New Horizon Electronics" ;
        foaf:homepage <https://github.com/Kiwooky/NHE-Can-Abyss>
    ] ;
    rdfs:comment "Electrostatic oil can delay modelled on 1960s Tel-Ray / Morley units. Leftover charge circles the disc every revolution (Reverb), the motor sets the time so sweeps bend pitch, and the warble follows disc speed. Modern mods: Disc Size, Sag, Hold, and Noise Mods with a predictive gate." ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/options#options> ,
                        <http://lv2plug.in/ns/ext/urid#map> ;
    lv2:extensionData <http://lv2plug.in/ns/ext/options#interface> ;
    lv2:port [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "Audio In"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out_mix" ;
        lv2:name "Mix Out"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_wet" ;
        lv2:name "Wet Out"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "time" ;
        lv2:name "Time" ;
        lv2:default 350 ;
        lv2:minimum 40 ;
        lv2:maximum 2000 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:ms
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "repeat" ;
        lv2:name "Repeat" ;
        lv2:default 3 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "reverb" ;
        lv2:name "Reverb" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "tone" ;
        lv2:name "Tone" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "wobble" ;
        lv2:name "Wobble" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "disc_size" ;
        lv2:name "Disc Size" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 50 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        units:unit units:pc
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "sag" ;
        lv2:name "Sag" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "hold" ;
        lv2:name "Hold" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled , mod:preferMomentaryOnByDefault
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "noise_mods" ;
        lv2:name "Noise Mods" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "disc_noise" ;
        lv2:name "Disc" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "hiss" ;
        lv2:name "Hiss" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "hum" ;
        lv2:name "Hum" ;
        lv2:default 5 ;
        lv2:minimum 0 ;
        lv2:maximum 10
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "hum_hz" ;
        lv2:name "Hum Hz" ;
        lv2:default 60 ;
        lv2:minimum 50 ;
        lv2:maximum 60 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        units:unit units:hz ;
        lv2:scalePoint [ rdfs:label "50 Hz" ; rdf:value 50 ] ,
                       [ rdfs:label "60 Hz" ; rdf:value 60 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "tails" ;
        lv2:name "Tails" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "lv2_enabled" ;
        lv2:name "Enabled" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled ;
        lv2:designation lv2:enabled
    ] .
