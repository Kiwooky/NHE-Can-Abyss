@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<https://github.com/Kiwooky/NHE-Can-Abyss>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-can-abyss.html> ;
        modgui:stylesheet <modgui/stylesheet-can-abyss.css> ;
        modgui:screenshot <modgui/screenshot-can-abyss.png> ;
        modgui:thumbnail <modgui/thumbnail-can-abyss.png> ;
        modgui:brand "New Horizon" ;
        modgui:label "Can-Abyss" ;
        modgui:port
        [ lv2:index 0 ; lv2:symbol "time" ; lv2:name "Time" ; ],
        [ lv2:index 1 ; lv2:symbol "repeat" ; lv2:name "Repeat" ; ],
        [ lv2:index 2 ; lv2:symbol "reverb" ; lv2:name "Reverb" ; ],
        [ lv2:index 3 ; lv2:symbol "tone" ; lv2:name "Tone" ; ],
        [ lv2:index 4 ; lv2:symbol "wobble" ; lv2:name "Wobble" ; ],
        [ lv2:index 5 ; lv2:symbol "disc_size" ; lv2:name "Disc Size" ; ],
        [ lv2:index 6 ; lv2:symbol "wear" ; lv2:name "Wear" ; ],
        [ lv2:index 7 ; lv2:symbol "mix" ; lv2:name "Mix" ; ],
        [ lv2:index 8 ; lv2:symbol "sag" ; lv2:name "Sag" ; ],
        [ lv2:index 9 ; lv2:symbol "hold" ; lv2:name "Hold" ; ],
        [ lv2:index 10 ; lv2:symbol "tails" ; lv2:name "Tails" ; ] ;
    ] .
